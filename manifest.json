{
  "id": "rashin-voz",
  "name": "Rashin Voz",
  "version": "0.1.0",
  "author": "Gustavo <gugaro8@gmail.com>",
  "description": "Habla con Rashin por voz: micrófono en la barra, respuestas leídas en voz alta.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 360
  },
  "files": [
    "bin/rashin-voz-tts"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Rashin Voz"
  },
  "dependencies": {
    "commands": [
      "rashin-voz"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "language",
        "type": "choice",
        "label": "Idioma de la conversación",
        "group": "Rashin Voz",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Automático (idioma del sistema)"
          },
          {
            "value": "es",
            "label": "Español"
          },
          {
            "value": "en",
            "label": "English"
          },
          {
            "value": "pt",
            "label": "Português"
          },
          {
            "value": "fr",
            "label": "Français"
          },
          {
            "value": "it",
            "label": "Italiano"
          },
          {
            "value": "de",
            "label": "Deutsch"
          },
          {
            "value": "ja",
            "label": "日本語"
          },
          {
            "value": "zh",
            "label": "中文"
          }
        ]
      },
      {
        "key": "speakReplies",
        "type": "toggle",
        "label": "Leer las respuestas en voz alta",
        "group": "Rashin Voz",
        "default": true
      }
    ]
  }
}
