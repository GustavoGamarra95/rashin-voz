{
  "id": "rashin-voz",
  "name": "Rashin Voz",
  "version": "0.1.0",
  "author": "Gustavo <gugaro8@gmail.com>",
  "description": "Habla con Rashin por voz: micrófono en la barra, respuestas leídas en voz alta.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 360
  },
  "files": [],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "Rashin Voz"
  },
  "dependencies": {
    "commands": [
      "rashin-voz"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "speakReplies",
        "type": "toggle",
        "label": "Leer las respuestas en voz alta",
        "group": "Rashin Voz",
        "default": true
      }
    ]
  }
}
